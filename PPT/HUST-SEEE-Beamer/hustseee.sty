\newcommand{\HUST@tocmetrics}{%
  % 目录使用扩展后的正文安全区：顶部 1.40/7.5，底部 6.48/7.5。
  % 1--5 项保持舒适条高，并按实际项目数自动拉伸间距，使首尾边界一致；
  % 超过 5 项时逐级压缩字号和条高，但仍使用相同的上下边界。
  \def\HUST@toctop{1.40}%
  \def\HUST@tocbottom{6.48}%
  \ifnum\beamer@sectionmax>10\relax
    \def\HUST@tocfontsize{22}\def\HUST@tocbaselineskip{27}%
    \def\HUST@tocnumfontsize{24}\def\HUST@tocnumbaselineskip{29}%
    \pgfmathsetmacro{\HUST@tocheight}{.40}%
  \else\ifnum\beamer@sectionmax>7\relax
    \def\HUST@tocfontsize{24}\def\HUST@tocbaselineskip{29}%
    \def\HUST@tocnumfontsize{27}\def\HUST@tocnumbaselineskip{32}%
    \pgfmathsetmacro{\HUST@tocheight}{.52}%
  \else\ifnum\beamer@sectionmax>5\relax
    \def\HUST@tocfontsize{27}\def\HUST@tocbaselineskip{33}%
    \def\HUST@tocnumfontsize{30}\def\HUST@tocnumbaselineskip{36}%
    \pgfmathsetmacro{\HUST@tocheight}{.68}%
  \else
    \def\HUST@tocfontsize{30}\def\HUST@tocbaselineskip{36}%
    \def\HUST@tocnumfontsize{32}\def\HUST@tocnumbaselineskip{38}%
    \pgfmathsetmacro{\HUST@tocheight}{.82}%
  \fi\fi\fi
  \ifnum\beamer@sectionmax>1\relax
    \pgfmathsetmacro{\HUST@tocstep}{%
      (\HUST@tocbottom-\HUST@toctop-\HUST@tocheight)/(\the\beamer@sectionmax-1)}%
  \else
    \pgfmathsetmacro{\HUST@toctop}{(1.40+6.48-\HUST@tocheight)/2}%
    \pgfmathsetmacro{\HUST@tocstep}{0}%
  \fi
}

\newcommand{\HUST@tocentry}[3]{%
  \HUST@tocmetrics%
  % 加宽目录条，给长章节标题留出单行排版空间。
  \pgfmathsetlength{\HUST@tocleftlen}{.120\paperwidth}%
  \pgfmathsetlength{\HUST@tocrightlen}{.920\paperwidth}%
  \pgfmathsetlength{\HUST@tocrowtoplen}{(\HUST@toctop+(#2-1)*\HUST@tocstep)*\paperheight/7.5}%
  \pgfmathsetlength{\HUST@tocheightlen}{\HUST@tocheight*\paperheight/7.5}%
  \setlength{\HUST@tocbottomlen}{\dimexpr\HUST@tocrowtoplen+\HUST@tocheightlen\relax}%
  \setlength{\HUST@tocradiuslen}{\dimexpr\HUST@tocheightlen/2\relax}%
  \setlength{\HUST@toccenterxlen}{\dimexpr\HUST@tocleftlen+\HUST@tocradiuslen\relax}%
  \setlength{\HUST@toccenterylen}{\dimexpr-\HUST@tocrowtoplen-\HUST@tocradiuslen\relax}%
  \pgfmathsetlength{\HUST@toctextxlen}{\HUST@tocleftlen+\HUST@tocheightlen+.016\paperwidth}%
  \pgfmathsetlength{\HUST@tocinnerradiuslen}{.726*\HUST@tocradiuslen}%
  \setlength{\HUST@toctextwidthlen}{\dimexpr\HUST@tocrightlen-\HUST@toctextxlen-.015\paperwidth\relax}%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={(current page.north west)},opacity=#1]
      \shade[left color=HUSTAgendaLeft,right color=HUSTAgendaRight,rounded corners=\HUST@tocradiuslen]
        (\HUST@tocleftlen,-\HUST@tocrowtoplen) rectangle (\HUST@tocrightlen,-\HUST@tocbottomlen);
      \fill[white] (\HUST@toccenterxlen,\HUST@toccenterylen) circle (\HUST@tocradiuslen);
      \shade[outer color=HUSTCircleBlue!75!HUSTDarkBlue,inner color=white]
        (\HUST@toccenterxlen,\HUST@toccenterylen) circle (\HUST@tocradiuslen);
      \fill[white] (\HUST@toccenterxlen,\HUST@toccenterylen) circle (\HUST@tocinnerradiuslen);
      \draw[HUSTCircleBlue!70!HUSTDarkBlue,line width=2.2pt]
        (\HUST@toccenterxlen,\HUST@toccenterylen) circle (\HUST@tocinnerradiuslen);
      \node[text=HUSTBlue,font=\rmfamily\bfseries\fontsize{\HUST@tocnumfontsize}{\HUST@tocnumbaselineskip}\selectfont]
        at (\HUST@toccenterxlen,\HUST@toccenterylen) {#2};
      \node[anchor=west,text=HUSTBlue,align=left,text width=\HUST@toctextwidthlen,
        font=\HUSTHeiFont\bfseries\fontsize{\HUST@tocfontsize}{\HUST@tocbaselineskip}\selectfont]
        at (\HUST@toctextxlen,\HUST@toccenterylen) {#3};
    \end{scope}%
  \end{tikzpicture}%
}

\setbeamertemplate{section in toc}{\HUST@tocentry{1}{\inserttocsectionnumber}{\inserttocsection}}
