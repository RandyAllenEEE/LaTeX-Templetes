\ifXeTeX
  \newcommand{\HUST@setseriffont}[1]{%
    \setCJKmainfont[Path=\HUST@fontpath,AutoFakeBold=1.8]{#1}%
    \setCJKfamilyfont{hustserif}[Path=\HUST@fontpath,AutoFakeBold=1.8]{#1}%
    \renewcommand{\HUSTSerifFont}{\CJKfamily{hustserif}}%
  }
  \newcommand{\HUST@setheifont}[1]{%
    \setCJKsansfont[Path=\HUST@fontpath,AutoFakeBold=1.8]{#1}%
    \setCJKfamilyfont{husthei}[Path=\HUST@fontpath,AutoFakeBold=1.8]{#1}%
    \renewcommand{\HUSTHeiFont}{\CJKfamily{husthei}}%
  }
  \newcommand{\HUST@setrefcjkfont}[1]{%
    \setCJKfamilyfont{hustrefcjk}[Path=\HUST@fontpath,AutoFakeBold=1.4,AutoFakeSlant=.2]{#1}%
    \renewcommand{\HUSTRefCJKFont}{\CJKfamily{hustrefcjk}}%
  }
  \newcommand{\HUST@setreflatinfontfile}[1]{%
    \newfontfamily\HUST@RefLatinFont[Path=\HUST@fontpath,Ligatures=TeX]{#1}%
    \renewcommand{\HUSTRefLatinFont}{\HUST@RefLatinFont}%
  }
  \newcommand{\HUST@setreflatinfontname}[1]{%
    \newfontfamily\HUST@RefLatinFont[Ligatures=TeX]{#1}%
    \renewcommand{\HUSTRefLatinFont}{\HUST@RefLatinFont}%
  }
  \IfFileExists{res/fonts/times.ttf}{%
    \setmainfont[Path=\HUST@fontpath,AutoFakeBold=2.2,AutoFakeSlant=.2]{times.ttf}%
    \newfontfamily\HUST@LatinFont[Path=\HUST@fontpath,Ligatures=TeX,AutoFakeBold=2.2,AutoFakeSlant=.2]{times.ttf}%
    \renewcommand{\HUSTLatinFont}{\HUST@LatinFont}%
  }{%
    \IfFileExists{res/fonts/TimesNewRoman.ttf}{%
      \setmainfont[Path=\HUST@fontpath,AutoFakeBold=2.2,AutoFakeSlant=.2]{TimesNewRoman.ttf}%
      \newfontfamily\HUST@LatinFont[Path=\HUST@fontpath,Ligatures=TeX,AutoFakeBold=2.2,AutoFakeSlant=.2]{TimesNewRoman.ttf}%
      \renewcommand{\HUSTLatinFont}{\HUST@LatinFont}%
    }{}%
  }
  \IfFileExists{res/fonts/STZhongsong.ttf}{\HUST@setseriffont{STZhongsong.ttf}}{%
    \IfFileExists{res/fonts/STZHONGS.TTF}{\HUST@setseriffont{STZHONGS.TTF}}{}%
  }
  \IfFileExists{res/fonts/SimHei.ttf}{\HUST@setheifont{SimHei.ttf}}{%
    \IfFileExists{res/fonts/simhei.ttf}{\HUST@setheifont{simhei.ttf}}{%
      \IfFileExists{res/fonts/Yahei.ttf}{\HUST@setheifont{Yahei.ttf}}{%
        \IfFileExists{res/fonts/msyh.ttf}{\HUST@setheifont{msyh.ttf}}{%
          \IfFileExists{res/fonts/msyh.ttc}{\HUST@setheifont{msyh.ttc}}{}%
        }%
      }%
    }%
  }
  \IfFileExists{res/fonts/msyh.ttf}{\HUST@setrefcjkfont{msyh.ttf}}{%
    \IfFileExists{res/fonts/msyh.ttc}{\HUST@setrefcjkfont{msyh.ttc}}{%
      \IfFileExists{res/fonts/Yahei.ttf}{\HUST@setrefcjkfont{Yahei.ttf}}{}%
    }%
  }
  \IfFileExists{res/fonts/Arial.ttf}{\HUST@setreflatinfontfile{Arial.ttf}}{%
    \IfFileExists{res/fonts/arial.ttf}{\HUST@setreflatinfontfile{arial.ttf}}{%
      \@ifundefined{IfFontExistsTF}{}{\IfFontExistsTF{Arial}{\HUST@setreflatinfontname{Arial}}{}}%
    }%
  }
\fi

\lstdefinestyle{HUSTCode}{%
  backgroundcolor=\color{HUSTCodeBackground},
  basicstyle=\ttfamily\fontsize{22}{26}\selectfont,
  keywordstyle=\color{HUSTCodeKeyword}\bfseries,
  commentstyle=\color{HUSTCodeComment}\itshape,
  stringstyle=\color{HUSTCodeString},
  numberstyle=\fontsize{22}{26}\selectfont\color{HUSTReferenceGray},
  numbers=none,
  numbersep=7pt,
  frame=single,
  rulecolor=\color{HUSTCodeRule},
  framerule=.55pt,
  framesep=5pt,
  xleftmargin=1.3em,
  xrightmargin=.4em,
  tabsize=2,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=true,
  columns=fullflexible,
  keepspaces=true,
  captionpos=b
}

\lstdefinestyle{HUSTAlgorithm}{%
  style=HUSTCode,
  basicstyle=\ttfamily\fontsize{22}{26}\selectfont,
  morekeywords={Input,Output,Initialize,for,while,if,else,end,return,do,then,to},
  keywordstyle=\color{HUSTCodeKeyword}\bfseries,
  numbers=none
}

