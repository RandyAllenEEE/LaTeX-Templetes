\newcommand{\HUST@measurebodylayout}{%
  \setlength{\HUST@bodylogowidth}{.125\paperwidth}%
  \setlength{\HUST@bodylogoheight}{.169\paperheight}%
  \ifdim\HUST@bodylogowidth>.155\paperheight\relax
    \setlength{\HUST@bodylogowidth}{.155\paperheight}%
  \fi
  \setlength{\HUST@headerlinestart}{\dimexpr.04335\paperwidth+\HUST@bodylogowidth+.045\paperwidth\relax}%
  \setlength{\HUST@headerlineend}{.98055\paperwidth}%
  \setlength{\HUST@frametitlewidth}{\dimexpr\HUST@headerlineend-\HUST@headerlinestart-.040\paperwidth\relax}%
  \ifdim\HUST@frametitlewidth<.52\paperwidth\relax
    \setlength{\HUST@frametitlewidth}{.52\paperwidth}%
  \fi
  \setlength{\HUST@frametitlecenterx}{\dimexpr\HUST@headerlinestart+\HUST@frametitlewidth/2\relax}%
}
\newcommand{\HUST@measureframetitle}{%
  \HUST@measurebodylayout%
  \sbox{\HUST@frametitlebox}{%
    \begin{minipage}{\HUST@frametitlewidth}%
      \centering\usebeamerfont{frametitle}\insertframetitle%
    \end{minipage}%
  }%
  \setlength{\HUST@frametitleheight}{\dimexpr\ht\HUST@frametitlebox+\dp\HUST@frametitlebox\relax}%
  % 略微上移正文内容起点，在不侵入标题安全区的前提下增加可用高度。
  \setlength{\HUST@frametitlevskip}{.1875\paperheight}%
  \ifdim\HUST@frametitlevskip<\dimexpr.035\paperheight+\HUST@frametitleheight+.060\paperheight\relax
    \setlength{\HUST@frametitlevskip}{\dimexpr.035\paperheight+\HUST@frametitleheight+.060\paperheight\relax}%
  \fi
}
\newcommand{\HUST@measurefootline}{%
  \setlength{\HUST@footlinetitlewidth}{.74\paperwidth}%
  \sbox{\HUST@footlinetitlebox}{%
    \begin{minipage}{\HUST@footlinetitlewidth}%
      \centering\usebeamerfont{footline}\insertshorttitle%
    \end{minipage}%
  }%
  \setlength{\HUST@footlinetitleheight}{\dimexpr\ht\HUST@footlinetitlebox+\dp\HUST@footlinetitlebox\relax}%
  \setlength{\HUST@footlineheight}{\dimexpr\HUST@footlinetitleheight+.155in\relax}%
  \ifdim\HUST@footlineheight<.438in\relax
    \setlength{\HUST@footlineheight}{.438in}%
  \fi
}
\newcommand{\HUST@measuretitlebar}{%
  \setlength{\HUST@titlebarmaxwidth}{.86\paperwidth}%
  \sbox{\HUST@titlebarbox}{%
    \begin{varwidth}{\HUST@titlebarmaxwidth}%
      \centering\usebeamerfont{title}\inserttitle%
    \end{varwidth}%
  }%
  \setlength{\HUST@titlebarheight}{\dimexpr\ht\HUST@titlebarbox+\dp\HUST@titlebarbox\relax}%
  \setlength{\HUST@titlebarheight}{\dimexpr\HUST@titlebarheight+\HUST@titlebarheight/5+\HUST@titlebarheight/10\relax}%
}
\newcommand{\HUST@measuretitlelayout}{%
  \HUST@measuretitlebar%
  \setlength{\HUST@titlelogowidth}{1.065\paperwidth}%
  \setlength{\HUST@titlelogoheight}{.180\paperheight}%
  \setlength{\HUST@titlebarcenter}{.376\paperheight}%
  \setlength{\HUST@titlebarmincenter}{\dimexpr.265\paperheight+\HUST@titlebarheight/2\relax}%
  \ifdim\HUST@titlebarcenter<\HUST@titlebarmincenter\relax
    \setlength{\HUST@titlebarcenter}{\HUST@titlebarmincenter}%
  \fi
  \setlength{\HUST@titleauthorblocktop}{\dimexpr\HUST@titlebarcenter+\HUST@titlebarheight/2+.060\paperheight\relax}%
}

\newcommand{\HUST@topdecorations}{%
  \HUST@measurebodylayout%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt]
      at ([xshift=.04335\paperwidth,yshift=-.0008\paperheight]current page.north west)
      {\includegraphics[width=\HUST@bodylogowidth,height=\HUST@bodylogoheight,keepaspectratio]{\HUSTLogoPath}};
    \draw[HUSTDarkBlue,line width=5pt]
      ([xshift=\HUST@headerlinestart,yshift=-.13333\paperheight]current page.north west)
      -- ([xshift=\HUST@headerlineend,yshift=-.13333\paperheight]current page.north west);
  \end{tikzpicture}%
}

\setbeamertemplate{background}{\HUST@topdecorations}

\setbeamertemplate{footline}{%
  \HUST@measurefootline%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=\HUST@footlineheight,dp=0pt]{footline}%
      \usebeamerfont{footline}%
      \vbox to \HUST@footlineheight{%
        \vfil%
        \hbox to \paperwidth{%
          \rlap{%
            \hbox to \paperwidth{%
              \hfill%
              \makebox[.08\paperwidth][r]{\insertframenumber}%
              \hspace*{.02325\paperwidth}%
            }%
          }%
          \hfill%
          \begin{minipage}{\HUST@footlinetitlewidth}%
            \centering\insertshorttitle%
          \end{minipage}%
          \hfill%
        }%
        \vfil%
      }%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

