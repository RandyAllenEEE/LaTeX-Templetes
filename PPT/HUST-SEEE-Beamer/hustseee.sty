    \global\beamer@framebottomskip=0pt\relax%
    \global\beamer@framebottomskipautobreak=0pt\relax%
  \fi
  \begingroup%
  \setlength{\HUST@referencewidth}{.95\paperwidth}%
  \ifHUST@framerefbottom\par\vfill\fi%
  \par\vspace{\HUST@framerefbeforeskip}%
  \noindent\makebox[0pt][l]{%
    \hspace*{-.0275\paperwidth}%
    \begin{minipage}{\HUST@referencewidth}%
      \begin{HUSTReferenceBlock}[HUSTReferenceGray]%
        \printbibliography[heading=none,segment=\therefsegment,check=HUSTFrameReferenceLimit]%
      \end{HUSTReferenceBlock}%
    \end{minipage}%
  }%
  \par%
  \ifHUST@framerefbottom\par\vspace{\HUST@framerefafterskip}\fi%
  \endgroup%
}

